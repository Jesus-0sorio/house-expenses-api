# Server Configuration
PORT=8080
GIN_MODE=debug
DEBUG=true

# Database Configuration (Driver: sqlite or postgres)
DB_DRIVER=sqlite
DB_DSN=file:local_expenses.db?cache=shared&mode=rwc

# PostgreSQL Configuration (used when DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=expenses
DB_PASSWORD=expenses_secret
DB_NAME=house_expenses
DB_SSLMODE=disable

# Authentication
JWT_SECRET=super_secret_jwt_key_house_expenses_2026

# External Microservices
DIAN_SERVICE_URL=http://localhost:8081

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback
